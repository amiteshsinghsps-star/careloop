# CareLoop environment. Copy to .env and adjust; never commit real secrets.

# --- core -------------------------------------------------------------------
# off = local demo (a dev identity binds the CASA01 household, no tokens needed)
# token = single shared bearer  |  oauth = full OAuth 2.1 + PKCE (what Alexa+ needs)
CARELOOP_AUTH=off
CARELOOP_DEMO=1
HOST=127.0.0.1
PORT=8080
CARELOOP_DB_ROOT=data

# Canonical public URL. The OAuth `resource` value and the add-on manifest MCP URI
# must match this string exactly, including the /mcp suffix and any trailing slash.
CARELOOP_PUBLIC_URL=http://localhost:8080

# --- household + clients ----------------------------------------------------
CARELOOP_FAMILY_PIN=481542
CARELOOP_CLIENT_ID=careloop-web-client
CARELOOP_CLIENT_SECRET=change-me-frontend
ALEXA_CLIENT_ID=alexa-client-placeholder
ALEXA_CLIENT_SECRET=change-me-alexa
CARELOOP_TOKEN=dev-token

# Comma-separated. Add every redirect URI Alexa registers; only exact matches are used.
CARELOOP_REDIRECT_URIS=http://localhost:8080/callback
# Extra browser origins allowed for CORS/Origin checks (dev servers are on by default).
CARELOOP_ALLOWED_ORIGINS=

# --- AWS (optional: without these the rules extractor is used) --------------
AWS_REGION=us-east-1
CARELOOP_BEDROCK_MODEL=
CARELOOP_BEDROCK_SMALL_MODEL=
# AWS_BEARER_TOKEN_BEDROCK=            # API key auth for Bedrock text models.
# Nova 2 Sonic (voice concierge) needs IAM credentials, not a Bedrock API key.

# --- rigor / ops ------------------------------------------------------------
CARELOOP_ENCRYPT_FIELDS=1
CARELOOP_SERVICE_TTL=3600
CARELOOP_CONTEXT_TTL=1800
# Injected faults for the game-day demo (each has a real call site):
#   bedrock_throttle -> rules fallback      verify_down -> model items flagged for confirmation
#   latency_800ms    -> p95 SLO fails      db_locked   -> reads work, every write refused
CARELOOP_CHAOS=
CARELOOP_RECORD_DIR=
CARELOOP_REPLAY_DIR=
CARELOOP_LOG=INFO
